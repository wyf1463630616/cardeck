<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="13dp"
    android:paddingTop="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="11dp"
        android:text="模拟发送 iAP2 Route Guidance 导航事件（0x5201/0x5202）到车机，验证 HUD 是否渲染转向指令。需先连接车机并完成链路。"
        android:textColor="#FF8E8E93"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="输入内容"
        android:textColor="#FFF5F5F7"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/hudMockInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#FF2C2C2E"
        android:hint="例：500m 后右转进入深南大道"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:maxLines="4"
        android:paddingLeft="10dp"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp"
        android:textColor="#FFF5F5F7"
        android:textColorHint="#FF636366"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnHudSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment_sel"
            android:paddingLeft="18dp"
            android:paddingTop="8dp"
            android:paddingRight="18dp"
            android:paddingBottom="8dp"
            android:text="发送 HUD 事件"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHudStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_segment"
            android:paddingLeft="18dp"
            android:paddingTop="8dp"
            android:paddingRight="18dp"
            android:paddingBottom="8dp"
            android:text="结束导航"
            android:textColor="#FF8E8E93"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="发送=0x5201 骨架+0x5202 右转/500m（文本作路名与指令）；结束=NO_ROUTE 收尾（HUD 灭卡）"
        android:textColor="#FF8E8E93"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="日志"
        android:textColor="#FFF5F5F7"
        android:textSize="14sp" />

    <ScrollView
        android:id="@+id/hudMockLogScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="#FF1C1C1E"
        android:fillViewport="true">

        <TextView
            android:id="@+id/hudMockLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingLeft="8dp"
            android:paddingTop="6dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp"
            android:text="— 等待操作 —"
            android:textColor="#FFAEAEB2"
            android:textSize="11sp" />
    </ScrollView>
</LinearLayout>
